# заголовки для WebSocket: включаются, только когда браузер их просит
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# порт 80: форточка для продления сертификата, всё остальное отправляем на HTTPS
server {
    listen 80;
    server_name {{ site_domain }};

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# порт 443: расшифровываем HTTPS и передаём приложению
server {
    listen 443 ssl;
    server_name {{ site_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ site_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ site_domain }}/privkey.pem;

    location / {
        proxy_pass http://{{ site_upstream }};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
    }
}
